# --- Telegram (my.telegram.org → API development tools) ---
TG_API_ID=1234567
TG_API_HASH=abcdef0123456789abcdef0123456789
CHANNEL=username_канала

# --- Кошелёк (НОВЫЙ, только под это). Приватный ключ base58 из Phantom: Настройки → Показать приватный ключ ---
PRIVATE_KEY=

# --- RPC (Helius: dashboard.helius.dev → API key) ---
RPC_URL=https://mainnet.helius-rpc.com/?api-key=ВАШ_КЛЮЧ
# дополнительные адреса, куда параллельно отправить транзакцию (через запятую), можно пусто
EXTRA_SEND_URLS=

# --- Сделка ---
BUY_AMOUNT_SOL=2
SLIPPAGE=50
PRIORITY_FEE=0.01
POOL=auto

# --- Окно времени (когда ждём пост). Пусто = всегда. Формат ISO с часовым поясом ---
WINDOW_START=2026-11-01T17:30:00+08:00
WINDOW_END=2026-11-01T23:00:00+08:00

# --- Безопасность ---
DRY_RUN=true
REQUIRE_PUMP_SUFFIX=false
POLL_INTERVAL=1.0
MAX_ATTEMPTS=4
